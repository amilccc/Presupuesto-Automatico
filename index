<script>
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzpErXIvKrR3HsAPNgx4SMM7uUXgKIlmuEfz8ZybWj87Jf2Zg9YW9lUfkCYVgxQMF1y/exec';

    let datosPresupuesto = [];
    let quincenaActual = 1;

    // Carga de datos compatible con Safari / GitHub Pages
    function cargarDatos() {
      const container = document.getElementById('contenedorPresupuesto');
      container.innerHTML = '<p class="text-center text-slate-500 text-sm py-4">Cargando presupuesto...</p>';
      
      const script = document.createElement('script');
      script.src = `${SCRIPT_URL}?callback=procesarRespuestaPresupuesto&_=${new Date().getTime()}`;
      document.body.appendChild(script);
    }

    function procesarRespuestaPresupuesto(data) {
      datosPresupuesto = data.presupuesto || [];
      renderPresupuesto();
    }

    function renderPresupuesto() {
      const container = document.getElementById('contenedorPresupuesto');
      container.innerHTML = '';

      if (datosPresupuesto.length === 0) {
        container.innerHTML = '<p class="text-slate-500 text-center text-sm">No hay datos en la pestaña Presupuesto.</p>';
        return;
      }

      datosPresupuesto.forEach(row => {
        const categoria = row[0];
        if (!categoria) return;

        const ideal = quincenaActual === 1 ? parseFloat(row[1]) || 0 : parseFloat(row[4]) || 0;
        const gastado = quincenaActual === 1 ? parseFloat(row[2]) || 0 : parseFloat(row[5]) || 0;
        const disponible = quincenaActual === 1 ? parseFloat(row[3]) || 0 : parseFloat(row[6]) || 0;

        if (ideal > 0 || gastado > 0) {
          const porcentaje = ideal > 0 ? Math.min(100, Math.round((gastado / ideal) * 100)) : 0;
          const esNegativo = disponible < 0;

          container.innerHTML += `
            <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-2">
              <div class="flex justify-between items-center">
                <span class="font-bold text-slate-200 text-sm">${categoria}</span>
                <span class="text-xs font-bold ${esNegativo ? 'text-red-400' : 'text-emerald-400'}">
                  Disp: Q${disponible.toFixed(2)}
                </span>
              </div>
              <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                <div class="${esNegativo ? 'bg-red-500' : 'bg-emerald-500'} h-full transition-all duration-300" style="width: ${porcentaje}%"></div>
              </div>
              <div class="flex justify-between text-[11px] text-slate-400">
                <span>Gastado: Q${gastado.toFixed(2)}</span>
                <span>Ideal: Q${ideal.toFixed(2)}</span>
              </div>
            </div>
          `;
        }
      });
    }

    function cambiarQuincena(q) {
      quincenaActual = q;
      document.getElementById('btnQ1').className = q === 1 ? "w-1/2 py-2.5 text-xs font-bold rounded-xl bg-emerald-600 text-white shadow-lg transition" : "w-1/2 py-2.5 text-xs font-bold rounded-xl text-slate-400 transition";
      document.getElementById('btnQ2').className = q === 2 ? "w-1/2 py-2.5 text-xs font-bold rounded-xl bg-emerald-600 text-white shadow-lg transition" : "w-1/2 py-2.5 text-xs font-bold rounded-xl text-slate-400 transition";
      renderPresupuesto();
    }

    async function guardarMovimiento(e) {
      e.preventDefault();
      const btn = document.getElementById('btnGuardar');
      btn.innerText = 'Guardando...';
      btn.disabled = true;

      const payload = {
        tipo: document.getElementById('tipo').value,
        cuenta: document.getElementById('cuenta').value,
        categoria: document.getElementById('categoria').value,
        descripcion: document.getElementById('descripcion').value,
        monto: document.getElementById('monto').value
      };

      try {
        await fetch(SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain' },
          body: JSON.stringify(payload)
        });

        alert('¡Movimiento guardado con éxito!');
        document.getElementById('formMovimiento').reset();
        setTimeout(cargarDatos, 1500);
      } catch (err) {
        alert('Error al guardar el movimiento.');
      } finally {
        btn.innerText = 'Guardar en Google Sheets';
        btn.disabled = false;
      }
    }

    cargarDatos();
  </script>
